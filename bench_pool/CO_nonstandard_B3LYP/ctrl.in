[ctrl]
     # 设置程序输出的程度，缺省为1
     print_level =               2
     # 设置Rayon和OpenMP的并行数，缺省为1
     num_threads =               4
     # 设置任务类型，缺省为“energy"
     job_type =                  "energy"
     ## 使用标准方式输入B3LYP方法
     #xc =                        "b3lyp"
     # 使用非标准方式输入B3LYP方法
     xc_type =                   "nonstandard" 
     xc_namelist =               ["lda_x_slater", "gga_x_b88", "lda_c_vwn_rpa", "gga_c_lyp"]
     xc_paralist =               [0.08, 0.72, 0.19, 0.81]
     xc_hybrid_para =            0.20
     
     basis_path =                "cc-pVDZ"
     auxbas_path =               "def2-SV(P)-JKFIT" 
     charge =                    0.0
     spin =                      1.0
     spin_polarization =         false
     #outputs =                   ["dipole"]

[geom]
     name = "CO"
     unit = "angstrom"
     position = '''
        C  0.00000000000      0.0000000000      0.0000000000
        O  1.20000000000      0.0000000000      0.0000000000
     '''

