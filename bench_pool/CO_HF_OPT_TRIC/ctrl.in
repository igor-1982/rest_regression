[ctrl]
     print_level =               1
     num_threads =               4
     job_type =                  "opt"
     xc =                        "HF"
     basis_path =                "cc-pVDZ"
     auxbas_path =               "def2-SV(P)-JKFIT"
     charge =                    0.0
     spin =                      1.0
     spin_polarization =         false
     opt_engine =                "geometric_pyo3"

[geometric_pyo3]
     maxiter = 100
     convergence_grms = 1.0e-4
     hessian = "first"

[geom]
     name = "CO"
     unit = "angstrom"
     position = '''
        C  0.00000000000      0.0000000000      0.0000000000
        O  1.20000000000      0.0000000000      0.0000000000
     '''
