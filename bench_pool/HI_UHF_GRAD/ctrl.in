[ctrl]
     # 设置程序输出的程度，缺省为1
     print_level =               1
     # 设置Rayon和OpenMP的并行数，缺省为1
     num_threads =               4
     # 设置使用的电子结构方法，缺省为HF
     xc =                        "hf" 
     basis_path =                "def2-TZVP"
     auxbas_path =               "def2-SVP-JKFIT" 
     # 使用resolution-of-identity (RI)技术处理四中心积分（缺省）
     eri_type =                  "ri_v"
     use_ri_symm =               true
     charge =                    -1.0
     spin =                      2.0
     spin_polarization =         true
     job_type =                  "force"
     auxbasis_response =         true


[geom]
     name = "NH3"
     unit = "angstrom"
     position = '''
        H   0.0  0.0  0.0
        I   0.0  0.0  3.0
    '''

