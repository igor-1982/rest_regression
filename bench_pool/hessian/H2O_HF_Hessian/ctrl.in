[ctrl]
    print_level =        1
    xc =                 "hf"
    basis_path =         "def2-svp"
    auxbas_path =        "def2-svp-rifit"
    basis_type =         "spheric"
    auxbas_type =        "spheric"
    eri_type =           "ri-v"
    use_ri_symm =        true
    charge =             0.0
    spin =               1.0
    spin_polarization =  false
    initial_guess =      "hcore"
    mixer =              "diis"
    num_threads =        8
    scf_acc_rho =        1.0e-8
    scf_acc_eev =        1.0e-6
    scf_acc_etot =       1.0e-8
    max_scf_cycle =      100

    [ctrl.hessian]
        solver = "dense"
        frequencies = false
        verbose = 1

[geom]
    name = "H2O"
    unit = "Angstrom"
    position = """
        O     0.00000000     0.00000000     0.12982363
        H     0.75933475     0.00000000    -0.46621158
        H    -0.75933475     0.00000000    -0.46621158
    """