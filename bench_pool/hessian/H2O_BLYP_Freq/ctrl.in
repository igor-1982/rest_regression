[ctrl]
    # pinned to the pre-2026-10 defaults (the reference values were recorded with them)
    radii_adjust = "becke"
    scf_acc_g = 1.0e-5
    scf_conv_criteria = "dm,eev"
    print_level =        1
    xc =                 "blyp"
    basis_path =         "def2-svp"
    auxbas_path =        "def2-svp-rifit"
    basis_type =         "spheric"
    auxbas_type =        "spheric"
    eri_type =           "ri-v"
    use_ri_symm =        true
    charge =             0.0
    spin =               1.0
    spin_polarization =  false
    initial_guess =      "hcore"
    mixer =              "diis"
    num_threads =        8
    scf_acc_rho =        1.0e-12
    scf_acc_eev =        1.0e-10
    scf_acc_etot =       1.0e-13
    max_scf_cycle =      100

    [ctrl.hessian]
        solver = "krylov"
        frequencies = true
        verbose = 1

[geom]
    name = "H2O"
    unit = "Angstrom"
    position = """
        O   0.00000000   0.00000000   0.11709209
        H   0.75677522   0.00000000  -0.46836837
        H  -0.75677522   0.00000000  -0.46836837
    """
