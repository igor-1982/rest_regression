[ctrl]
     # pinned to the pre-2026-10 defaults (the reference values were recorded with them)
     scf_acc_rho = 1.0e-8
     scf_acc_eev = 1.0e-6
     scf_acc_etot = 1.0e-8
     scf_acc_g = 1.0e-5
     scf_conv_criteria = "dm,eev"
     print_level =          2
     job_type =             "numerical dipole"
     xc =                   "mp2"
     basis_path =           "def2-TZVP"
     auxbas_path =          "def2-universal-jkfit"
     guessfile =            "none"
     charge =               0.0
     spin =                 1.0
     spin_polarization =    false
     num_threads =          4

[ctrl.ri_pt2]
fp_mode = "FP64"

[geom]
    name = "NH3"
    unit = "Angstrom"
    position = """
N          0.99937        0.10722       -0.07906
H          2.01670        0.05042       -0.06566
H          0.68777       -0.21994        0.83431
H          0.68777       -0.59378       -0.74977
    """
