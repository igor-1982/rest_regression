[ctrl]
     # 设置程序输出的程度，缺省为1
     print_level =               1
     # 设置Rayon和OpenMP的并行数，缺省为1
     num_threads =               4
     # 设置任务类型，缺省为“energy"
     job_type =                  "opt"
     numerical_force =           true
     # 设置使用的电子结构方法，缺省为HF
     xc =                        "HF" 
     basis_path =                "cc-pVDZ"
     auxbas_path =               "def2-SV(P)-JKFIT" 
     charge =                    0.0
     spin =                      1.0
     spin_polarization =         false
     #outputs =                   ["dipole"]

[geom]
     name = "CO"
     unit = "angstrom"
     position = '''
        C  0.00000000000      0.0000000000      0.0000000000
        O  1.20000000000      0.0000000000      0.0000000000
     '''

