[ctrl]
     # 设置程序输出的程度，缺省为1
     print_level =               1
     # 设置Rayon和OpenMP的并行数，缺省为1
     num_threads =               4
     # 设置使用的电子结构方法，缺省为HF
     xc =                        "scan" 
     basis_path =                "cc-pVDZ"
     auxbas_path =               "def2-universal-jkfit" 
     # 使用resolution-of-identity (RI)技术处理四中心积分（缺省）
     eri_type =                  "ri_v"
     #use_ri_vj =                 "false"
     use_ri_symm =               true
     charge =                    0.0
     spin =                      1.0
     spin_polarization =         false

[quasiparticle_methods]
     gw_or_bse=      "bse"
     bse_tda=false
     bse_davidson_solver=false
     bse_feast_solver=true
     bse_eigenrange_min=         0.2
     bse_eigenrange_max=         0.3
     bse_m_expected=            6
     bse_feast_renormalized_doubles=true
     bse_renormalized_doubles_extra_width=0.02
     bse_auxbas_path=            "cc-pvdz-rifit"
     bse_matvec_style=           "ao"
          davidson_maximum_subspace_size=1000
          gw_scheme=                  "extrapolated"
     bse_spin=                   "singlet"
     threshold=                  0.3

[geom]
     name = "NH3"
     unit = "angstrom"
     position = '''
        N  -2.1988391019      1.8973746268      0.0000000000
        H  -1.1788391019      1.8973746268      0.0000000000
        H  -2.5388353987      1.0925460144     -0.5263586446
        H  -2.5388400276      2.7556271745     -0.4338224694'''

