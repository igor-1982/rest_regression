[ctrl]
     # pinned to the pre-2026-10 defaults (the reference values were recorded with them)
     radii_adjust = "becke"
     scf_acc_eev = 1.0e-6
     scf_acc_etot = 1.0e-8
     scf_acc_g = 1.0e-5
     scf_conv_criteria = "dm,eev"
     print_level =               1
     num_threads =               4
     xc =                        "pbe0"
     basis_path =                "def2-svp"
     auxbas_path =               "def2-svp-rifit"
     eri_type =                  "ri-v"
     spin =                      1.0
     scf_acc_rho =               1.0e-8
     outname =                   "reference"

[tddft]
     tddft_method =              "tda"
     tddft_spin =                "both"
     tddft_mode =                "ao"
     nroots =                    2

[geom]
     name = "H2O"
     unit = "angstrom"
     position = '''
        O  0.0    0.0    0.0
        H  0.757  0.586  0.0
        H -0.757  0.586  0.0
     '''
