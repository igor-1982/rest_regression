[ctrl]
    # pinned to the pre-2026-10 defaults (the reference values were recorded with them)
    radii_adjust = "becke"
    scf_acc_rho = 1.0e-8
    scf_acc_eev = 1.0e-6
    scf_acc_etot = 1.0e-8
    scf_acc_g = 1.0e-5
    scf_conv_criteria = "dm,eev"
    print_level =          2
    num_threads =          4
    xc =                   "b3lyp"
    basis_path =           "def2-tzvp"
    auxbas_path =          "def2-universal-jkfit"
    eri_type =             "ri-v"
    charge =               1.0
    spin =                 2.0
    spin_polarization =    true
    auxbasis_response =    true
    mixer =                "diis"
    num_max_diis =         8
    start_diis_cycle =     3
    mix_param =            0.8
    max_scf_cycle =        100
    outname =              "reference"
    analdrv_tasks =        ["multipole"]

[geom]
    name = "NH3p"
    unit = "Angstrom"
    position = """
N   0.00000000   0.00000000   0.00000000
H   0.62000000   0.10000000   0.90000000
H  -0.55000000  -0.25000000   0.90000000
H   0.02000000   0.70000000  -0.75000000
    """
