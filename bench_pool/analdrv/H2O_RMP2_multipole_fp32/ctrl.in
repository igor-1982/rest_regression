[ctrl]
    # pinned to the pre-2026-10 defaults (the reference values were recorded with them)
    scf_acc_rho = 1.0e-8
    scf_acc_eev = 1.0e-6
    scf_acc_etot = 1.0e-8
    scf_acc_g = 1.0e-5
    scf_conv_criteria = "dm,eev"
    print_level =          2
    num_threads =          4
    xc =                   "mp2"
    basis_path =           "def2-tzvp"
    auxbas_path =          "def2-universal-jkfit"
    eri_type =             "ri-v"
    charge =               0.0
    spin =                 1.0
    spin_polarization =    false
    auxbasis_response =    true
    mixer =                "diis"
    num_max_diis =         8
    start_diis_cycle =     3
    mix_param =            0.8
    max_scf_cycle =        100
    outname =              "reference"
    analdrv_tasks =        ["multipole"]

[ctrl.ri_pt2]
    new_driver =           true
    fp_mode =              "FP32"

[geom]
    name = "H2O"
    unit = "Angstrom"
    position = """
O   0.00000000   0.00000000   0.11537521
H   0.75036929   0.00000000  -0.45898737
H  -0.75036929   0.00000000  -0.45898737
    """
