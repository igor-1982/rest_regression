[ctrl]
    print_level =          1
    num_threads =          4
    xc =                   "b3lyp-d3bj"
    xc_parser =            "parse_xc"  # the -d3bj suffix requires the parse_xc parser
    basis_path =           "def2-svp"
    auxbas_path =          "def2-universal-jkfit"
    eri_type =             "ri-v"
    charge =               0.0
    spin =                 1.0
    spin_polarization =    false
    auxbasis_response =    true
    mixer =                "diis"
    num_max_diis =         8
    start_diis_cycle =     3
    mix_param =            0.8
    max_scf_cycle =        100
    outname =              "reference"
    analdrv_tasks =        ["hessian"]


[thermo]
temperature = 298.15
pressure = 1.0

[geom]
    name = "C2H6"
    unit = "Angstrom"
    position = """
C        0.00000000      0.00000000      0.76750000
C        0.00000000      0.00000000     -0.76750000
H        1.02040000      0.00000000      1.15920000
H       -0.51020000      0.88378700      1.15920000
H       -0.51020000     -0.88378700      1.15920000
H        0.51020000      0.88378700     -1.15920000
H       -1.02040000      0.00000000     -1.15920000
H        0.51020000     -0.88378700     -1.15920000
    """
