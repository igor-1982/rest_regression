# Ammonia analytic gradient of a global hybrid (PBE0) with the storage-level AO-pair
# pruning switched off. The keyword is written out at its default value, so this case
# locks that the *value* of pair_screen_threshold (not its presence) selects the
# unpruned path, and it is the reference of the pruned gradient next to it.

[ctrl]
     print_level =               1
     num_threads =               4
     job_type =                  "force"
     xc =                        "pbe0"
     basis_path =                "def2-svp"
     auxbas_path =               "def2-universal-jkfit"
     eri_type =                  "ri_v"
     use_ri_symm =               true
     auxbasis_response =         true
     charge =                    0.0
     spin =                      1.0
     spin_polarization =         false

[ctrl.ri_jk]
     pair_screen_threshold =     0.0

[geom]
    name = "NH3"
    unit = "Angstrom"
    position = """
        N   0.0         0.0         0.0       
        H   1.0         0.0         0.0       
        H  -0.34202014  0.0         0.93969262
        H  -0.34202014  0.81379768 -0.46984631
    """
