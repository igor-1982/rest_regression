[ctrl]
     # 设置程序输出的程度，缺省为1
     print_level =               1
     # 设置Rayon和OpenMP的并行数，缺省为1
     num_threads =               4
     # 设置使用的电子结构方法，缺省为HF
     xc =                        "x3lyp" 
     basis_path =                "def2-SVP"
     auxbas_path =               "def2-universal-jkfit" 
     # 使用resolution-of-identity (RI)技术处理四中心积分（缺省）
     eri_type =                  "ri_v"
     use_ri_symm =               true
     charge =                    0.0
     spin =                      3.0
     spin_polarization =         true
     job_type =                  "force"
     numerical_force =           true
     auxbasis_response =         true


[geom]
     name = "O2"
     unit = "angstrom"
     position = '''
          O    0.0000000000       0.0000000000       0.0000000000
          O    1.2080000000       0.0000000000       0.0000000000
     '''
     ext_field_dipole = [0.0, 0.0, 0.001]

