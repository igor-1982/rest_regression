[ctrl]
     print_level =               1
     num_threads =               4
     job_type =                  "opt"
     opt_engine =                "geometric-pyo3"
     numerical_force =           false
     xc =                        "x3lyp" 
     empirical_dispersion =      "d3bj"
     basis_path =                "cc-pVDZ"
     auxbas_path =               "def2-SV(P)-JKFIT" 
     charge =                    0.0
     spin =                      2.0
     spin_polarization =         true

[geometric_pyo3]
     transition =                true
     hessian =                   "last"
     frequency =                 true

